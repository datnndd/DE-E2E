# =============================================================================
# Airflow runtime
# =============================================================================
AIRFLOW_UID=50000
AIRFLOW_WEBSERVER_PORT=8080
_PIP_ADDITIONAL_REQUIREMENTS=

# Airflow -> ingestion-worker endpoint inside Docker network.
INGESTION_WORKER_URL=http://ingestion-worker:8000

# =============================================================================
# AWS / S3 storage
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1

S3_BUCKET=
S3_LANDING_PREFIX=lakehouse/landing/douyin/api_raw/json
S3_MEDIA_PREFIX=lakehouse/landing/douyin/media_raw
S3_MEDIA_MANIFEST_PREFIX=lakehouse/landing/douyin/media_manifest/json
S3_CONTROL_PREFIX=lakehouse/control/douyin/processed_seed_files

# Enable/disable immediate media download from temporary Douyin URLs.
DOUYIN_DOWNLOAD_MEDIA=true
DOUYIN_MEDIA_DOWNLOAD_WORKERS=4
DOUYIN_MEDIA_DOWNLOAD_TIMEOUT=180
DOUYIN_MEDIA_CHUNK_SIZE=1048576
DOUYIN_MEDIA_RETRY_TIMES=3
DOUYIN_MEDIA_RETRY_BACKOFF_SECONDS=2

# =============================================================================
# Seed CSV input for Airflow DAG
# =============================================================================
# Leave AIRFLOW_DOUYIN_SEED_CSV_FILE empty to auto-pick latest unprocessed *.csv.
AIRFLOW_DOUYIN_SEED_CSV_FILE=
AIRFLOW_DOUYIN_SEED_CSV_DIR=/opt/airflow/seeds
AIRFLOW_DOUYIN_SEED_CSV_PATTERN=*.csv

# =============================================================================
# Databricks job trigger
# =============================================================================
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_JOB_ID=
DATABRICKS_RUN_POLL_SECONDS=30
DATABRICKS_RUN_TIMEOUT_MINUTES=120

# =============================================================================
# Ingestion-worker local test endpoint defaults
# =============================================================================
INGESTION_WORKER_PORT=8000
DOUYIN_LINK=
DOUYIN_MODE=post
DOUYIN_LIMIT=20
DOUYIN_START_TIME=
DOUYIN_END_TIME=

# Optional legacy seed path mounted inside ingestion-worker container.
DOUYIN_SEED_FILE=/app/seeds/douyin_food_restaurant_seeds.yml

# =============================================================================
# Douyin cookies
# =============================================================================
DOUYIN_MSTOKEN=
DOUYIN_TTWID=
DOUYIN_ODIN_TT=
DOUYIN_PASSPORT_CSRF_TOKEN=

# Optional login/session cookies; fill only if needed.
DOUYIN_SID_GUARD=
DOUYIN_SESSIONID=
DOUYIN_SID_TT=
